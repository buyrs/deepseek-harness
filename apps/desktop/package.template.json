{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "description": "macOS desktop shell that hosts the dsh web profile in an Electron window",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DeepSeek Harness",
    "asar": false,
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../stage",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../node-runtime",
        "to": "node"
      }
    ],
    "electronDist": "../electron-dist",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
